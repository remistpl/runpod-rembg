{
  "tests": [
    {
      "name": "single_url_default_model",
      "input": {
        "image_url": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/PNG_transparency_demonstration_1.png/600px-PNG_transparency_demonstration_1.png"
      },
      "timeout": 180000
    },
    {
      "name": "multi_image_batch",
      "input": {
        "image_urls": [
          "https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/PNG_transparency_demonstration_1.png/600px-PNG_transparency_demonstration_1.png",
          "https://upload.wikimedia.org/wikipedia/commons/thumb/8/87/PNG_transparency_demonstration_2.png/600px-PNG_transparency_demonstration_2.png"
        ],
        "model": "u2netp",
        "max_size": 768
      },
      "timeout": 240000
    },
    {
      "name": "mask_only",
      "input": {
        "image_url": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/PNG_transparency_demonstration_1.png/600px-PNG_transparency_demonstration_1.png",
        "only_mask": true,
        "output_format": "png"
      },
      "timeout": 180000
    },
    {
      "name": "alpha_matting",
      "input": {
        "image_url": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/PNG_transparency_demonstration_1.png/600px-PNG_transparency_demonstration_1.png",
        "alpha_matting": true,
        "alpha_matting_foreground_threshold": 240,
        "alpha_matting_background_threshold": 10,
        "alpha_matting_erode_size": 10,
        "post_process_mask": true
      },
      "timeout": 240000
    },
    {
      "name": "composite_white_background",
      "input": {
        "image_url": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/PNG_transparency_demonstration_1.png/600px-PNG_transparency_demonstration_1.png",
        "bgcolor": "#FFFFFF",
        "output_format": "jpg",
        "return_mask": true
      },
      "timeout": 180000
    },
    {
      "name": "isnet_general_use",
      "input": {
        "image_url": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/PNG_transparency_demonstration_1.png/600px-PNG_transparency_demonstration_1.png",
        "model": "isnet-general-use",
        "max_size": 1024
      },
      "timeout": 240000
    },
    {
      "name": "webp_with_max_size",
      "input": {
        "image_url": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/PNG_transparency_demonstration_1.png/600px-PNG_transparency_demonstration_1.png",
        "output_format": "webp",
        "max_size": 1024,
        "quality": 90
      },
      "timeout": 180000
    },
    {
      "name": "return_bbox",
      "input": {
        "image_url": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/PNG_transparency_demonstration_1.png/600px-PNG_transparency_demonstration_1.png",
        "return_bbox": true,
        "return_mask": true
      },
      "timeout": 180000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA GeForce RTX 4090",
    "gpuCount": 1,
    "env": [
      {
        "key": "REMBG_MODEL",
        "value": "u2net"
      }
    ],
    "allowedCudaVersions": [
      "12.7",
      "12.6",
      "12.5",
      "12.4",
      "12.3",
      "12.2",
      "12.1",
      "12.0"
    ]
  }
}
